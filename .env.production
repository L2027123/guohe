# ContentOS 生产环境配置
# 版本信息
VITE_APP_VERSION=2.0.0-beta
VITE_APP_NAME=果核 - AI爆款拆解
VITE_APP_DESCRIPTION=AI 内容创作助手

# API 配置（API Key 由用户在浏览器端配置，不存储在代码中）
VITE_API_BASE_URL=https://api.deepseek.com/v1

# 构建配置
VITE_BUILD_TARGET=es2018
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_TRACKING=false

# Beta 信息
VITE_BETA_MODE=true
VITE_BETA_EXPIRY=2026-12-31
