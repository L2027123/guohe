# 面包多支付验证
# 获取方式：面包多 → 编辑资料 → 开发设置 → 开发者 Key
MIANBAODUO_TOKEN=your_mianbaoduo_developer_key

# 可选：限制只接受特定商品的订单（逗号分隔多个 urlkey）
# MIANBAODUO_PRODUCT_KEYS=your_product_url_key

# 激活码签名密钥（任意随机字符串，用于防止前端伪造激活态）
ACTIVATION_SECRET=your_random_secret_string

# 前端展示：面包多购买链接
NEXT_PUBLIC_MIANBAODUO_BUY_URL=https://mbd.pub/o/bread/your_product_key
